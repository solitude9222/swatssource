# ═══════════════════════════════════════════════════════════════════════
#  tourn.lol — ONE env file for everything.
#
#  • VITE_ vars  → bundled into the public JS. Safe to expose. These also
#                  go into your host's build settings (Netlify/Vercel).
#  • Plain vars  → ignored by Vite, never shipped to the browser. They are
#                  here for your local backend work; the SAME plain vars
#                  must also be set in the Railway backend's environment.
#
#  .env is gitignored — never commit it.
#  Copy this file to .env and fill in the blanks.
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────── REQUIRED ─────────────────────────
# Supabase → Project Settings → API  (Project URL + anon public key)
# Without these, sign-in is disabled (the UI says so).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The email of YOUR account (the one you sign up with via Discord, or set
# in Settings → Security). Your profile renders on the home card + /demo
# and you get the owner-alias control.
VITE_OWNER_EMAIL=

# ─────────────── PUBLIC CLIENT IDS (already filled) ───────────────
VITE_DISCORD_CLIENT_ID=1557279875423932467
VITE_SPOTIFY_CLIENT_ID=b5e787041316466893ef7eabfb717e3a
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFThWr36t2uJbW1e

# ───────────────────────── OPTIONAL (frontend) ─────────────────────────
# Premium checkout — Stripe → Developers → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=
# Backend base URL (swatssource on Railway)
VITE_API_BASE_URL=https://swatssource-production.up.railway.app

# ═══════════════════════════════════════════════════════════════════════
#  SERVER-ONLY SECRETS — never VITE_-prefixed, never committed.
#  Vite ignores these; they matter when you run the backend locally and
#  MUST ALSO be set in the Railway backend's environment variables.
# ═══════════════════════════════════════════════════════════════════════

# Supabase service role (bypasses RLS — backend only!)
SUPABASE_SERVICE_ROLE_KEY=

# Discord OAuth secret (Developer Portal → OAuth2 → Client Secret)
DISCORD_CLIENT_SECRET=

# tourn.lol verification bot (DMs 6-digit codes for password/2FA changes)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Backend session/JWT + database (Railway provides DATABASE_URL automatically
# if you provision a database plugin there)
JWT_SECRET=
DATABASE_URL=
ADMIN_PASSWORD=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Misc server-side
SPOTIFY_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
VIEW_SECRET=
