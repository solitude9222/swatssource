# Copy to .env and fill in. Without the two Supabase values below, sign-in is
# disabled and the auth dialog explains exactly that — there are no local
# demo accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Email of the owner account (must match the Discord OAuth email OR the email
# set on the Supabase account). The owner's profile renders on the home page
# card and at /demo; this email also unlocks the owner alias control.
VITE_OWNER_EMAIL=

# Public OAuth client ids — safe to expose, these are not secrets.
VITE_DISCORD_CLIENT_ID=
VITE_SPOTIFY_CLIENT_ID=

# Cloudflare Turnstile site key — designed to be public/embeddable.
VITE_TURNSTILE_SITE_KEY=

# Stripe publishable key — safe to expose once you have one (Premium checkout).
VITE_STRIPE_PUBLISHABLE_KEY=

# Base URL of the backend API this frontend calls (swatssource on Railway).
VITE_API_BASE_URL=

# Everything else (JWT_SECRET, DATABASE_URL, ADMIN_PASSWORD,
# DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN, STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, SPOTIFY_CLIENT_SECRET, Cloudinary's api_secret,
# TURNSTILE_SECRET_KEY, VIEW_SECRET) is a server-only secret. It belongs in
# the backend's own hosting environment config, never in a VITE_ var here.
