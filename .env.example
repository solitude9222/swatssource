# ═══════════════════════════════════════════════════════════════════════
#  tourn.lol — THE complete env (one file, everything).
#
#  • VITE_ vars  → public. Bundled into the frontend JS / served by the
#                  backend's /env.js. Safe to expose.
#  • Plain vars  → secrets + server config. Vite ignores them; they are
#                  for the Railway backend ONLY. Never VITE_-prefix them.
#
#  Supabase IS your Postgres — there is no separate database to install.
#  .env is gitignored. Copy → .env and fill the blanks.
# ═══════════════════════════════════════════════════════════════════════

# ───────────────────────── URLs ─────────────────────────
# Where the frontend lives (used for OAuth redirects, CORS, email links)
FRONTEND_URL=https://tourn.lol
# Where the backend lives (Railway gives you this on deploy)
BACKEND_URL=https://tourn-production.up.railway.app
# Frontend → backend calls
VITE_API_BASE_URL=https://tourn-production.up.railway.app

# ─────────────── Supabase (auth + built-in Postgres) ───────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role bypasses RLS — backend only, NEVER in a VITE_ var
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → Database → Connection string → URI
DATABASE_URL=

# ─────────────── Owner / admin accounts ───────────────
# Your personal account email → owner profile on home + /demo
VITE_OWNER_EMAIL=
# Backend admin account (alerts, seeded admin login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─────────────── Discord (sign-up + bot) ───────────────
# Developer Portal → OAuth2 (public id — already filled)
VITE_DISCORD_CLIENT_ID=1557279875423932467
# Developer Portal → OAuth2 → Reset Secret
DISCORD_CLIENT_SECRET=
# Developer Portal → Bot → Reset Token (the verification-codes bot)
DISCORD_BOT_TOKEN=
# Your server's id (right-click server → Copy Server ID)
DISCORD_GUILD_ID=
# For reference only — Supabase handles the real redirect
DISCORD_REDIRECT_URI=

# ─────────────── Spotify ───────────────
VITE_SPOTIFY_CLIENT_ID=b5e787041316466893ef7eabfb717e3a
SPOTIFY_CLIENT_SECRET=

# ─────────────── Security / sessions ───────────────
# random 64+ chars — openssl rand -hex 32
JWT_SECRET=
VIEW_SECRET=

# ─────────────── Payments (Premium checkout — later) ───────────────
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────────── Bot protection ───────────────
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFThWr36t2uJbW1e
TURNSTILE_SECRET_KEY=
