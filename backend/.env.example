# ─────────────────────────────────────────────────────────────────────────────
# tourn.lol Backend — Environment Variables
# Copy this to .env (never commit .env) and fill in every value marked REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Paste the full connection string from your PostgreSQL provider.
# Providers: Railway, Supabase, Neon, Render, PlanetScale (Postgres mode)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Cloudinary — image storage (REQUIRED) ────────────────────────────────────
# Use EITHER the CLOUDINARY_URL form OR the three separate vars. Not both.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# -- OR --
# CLOUDINARY_CLOUD_NAME=yourcloudname
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret_here

# ── JWT (REQUIRED) ────────────────────────────────────────────────────────────
# A long random string — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_64_char_random_hex_string

# ── App domain (REQUIRED) ─────────────────────────────────────────────────────
# The public URL of the FRONTEND (used to build og:image absolute URLs etc.)
PUBLIC_URL=https://tourn.lol
# The public URL of this BACKEND (used in email links, OAuth callbacks, etc.)
BACKEND_URL=https://api.tourn.lol

# ── Discord OAuth (for "Connect Discord" login flow) ─────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://tourn.lol/!/auth/discord
# Your own Discord guild/server ID for the community card in the sidebar
DISCORD_GUILD_ID=
# A Discord Bot token — needed for the Lanyard-style live widget data
DISCORD_BOT_TOKEN=

# ── Stripe (for Premium subscriptions) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_PRICE_ID_YEARLY=price_...

# ── Rate-limiting & security ──────────────────────────────────────────────────
# Leave blank to disable (default: 100 requests / 15 min per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "false" to disable new registrations (maintenance / invite-only mode)
REGISTRATIONS_OPEN=true

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
